{
  "name": "aniplayer",
  "version": "1.0.3",
  "type": "module",
  "description": "AniPlayer — аниме-плеер нового поколения для Windows и iPad",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "cross-env BUILD_TARGET=web vite build",
    "build:electron": "vite build && node -e \"fs.copyFileSync('electron/preload.cjs','dist-electron/preload.cjs')\" && electron-builder",
    "pack": "vite build && node -e \"fs.copyFileSync('electron/preload.cjs','dist-electron/preload.cjs')\" && electron-builder --dir",
    "preview": "vite preview",
    "cap:sync": "npx cap sync ios",
    "cap:open": "npx cap open ios"
  },
  "keywords": [
    "anime",
    "player",
    "electron",
    "capacitor",
    "anilibria",
    "shikimori",
    "animix"
  ],
  "author": "Ivan",
  "license": "MIT",
  "dependencies": {
    "@capacitor/core": "^7.0.1",
    "@capacitor/ios": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "hls.js": "^1.6.15",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.3",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
